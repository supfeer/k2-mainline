#!/bin/sh /etc/rc.common

START=98
STOP=98
USE_PROCD=1
DEPEND=fstab

PROG=/usr/bin/go2rtc
USER_DATA=/mnt/UDISK/printer_data
CONF=${USER_DATA}/config/go2rtc.yaml
DEFAULT_CONF=/etc/go2rtc/go2rtc.yaml

seed_if_missing()
{
    local src="$1"
    local dst="$2"
    if [ ! -s "$dst" ] && [ -f "$src" ]; then
        cp -f "$src" "${dst}.tmp" && sync && mv "${dst}.tmp" "$dst" && sync
    fi
}

start_service() {
    [ "x$(get_sn_mac.sh pcba_test)" = "x1" ] && exit 0
    [ -x "$PROG" ] || exit 1

    mkdir -p "${USER_DATA}/config"
    seed_if_missing "$DEFAULT_CONF" "$CONF"

    procd_open_instance
    procd_set_param command ${PROG} -c ${CONF}
    procd_set_param respawn 3600 5 5
    procd_close_instance
}
