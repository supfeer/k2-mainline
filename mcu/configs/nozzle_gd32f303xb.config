CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_GD32=y
CONFIG_BOARD_DIRECTORY="gd32"
CONFIG_MACH_GD32F303XB=y
CONFIG_GD32_FLASH_START_3000=y
CONFIG_GD32_SERIAL_USART1_PA2_PA3=y
CONFIG_SERIAL_BAUD=230400
CONFIG_GD32_TRANSPARENT_SERIAL_USART2_PB10_PB11=y
CONFIG_TRANSPARENT_SERIAL=y
CONFIG_TRANSPARENT_SERIAL_BAUD=230400
CONFIG_WANT_FANCHECK=y
CONFIG_BOARD_INFO_CONFIGURE=y
CONFIG_NOZZLE_MCU_BOARD=y
CONFIG_MCU_BOARD_ID="0"
CONFIG_MCU_BOARD_HW_VER="130"
CONFIG_MCU_BOARD_FW_VER="021"
CONFIG_MCU_BOARD_FW_RESERVED="950"
CONFIG_USE_NEW_CRC16=y
CONFIG_INITIAL_PINS="!PB1,!PB3,!PB8,!PB15"
CONFIG_WANT_ADC=y
CONFIG_WANT_SPI=y
CONFIG_WANT_SOFTWARE_SPI=y
CONFIG_WANT_BUTTONS=y
CONFIG_WANT_TMCUART=y
# CONFIG_WANT_NEOPIXEL is not set
CONFIG_WANT_PULSE_COUNTER=y
# CONFIG_WANT_ST7920 is not set
# CONFIG_WANT_HD44780 is not set
# CONFIG_WANT_ADXL345 is not set
CONFIG_WANT_LIS2DW=y
# CONFIG_WANT_BMI160 is not set
# CONFIG_WANT_THERMOCOUPLE is not set
# CONFIG_WANT_HX71X is not set
CONFIG_WANT_CS1237=y
# CONFIG_WANT_ADS131M0X is not set
# CONFIG_WANT_ADS1220 is not set
# CONFIG_WANT_SENSOR_ANGLE is not set
CONFIG_WANT_TRIGGER_ANALOG=y
